import java.util.Scanner;

public class NumberGuisseingGame {

    static int low = 1;
    static int high = 100;

    // Method 
    public static int generateGuess() {
        return (low + high) / 2;
    }

    // Method 
    public static String getUserFeedback(Scanner sc) {
        System.out.print("Enter feedback (high / low / correct): ");
        return sc.nextLine().toLowerCase();
    }

    // Method 
    public static void updateRange(String feedback, int guess) {
        if (feedback.equals("high")) {
            high = guess - 1;
        } else if (feedback.equals("low")) {
            low = guess + 1;
        }
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);
        System.out.println("Think of a number between 1 and 100.");
        System.out.println("I will try to guess it!");

        while (true) {
            int guess = generateGuess();
            System.out.println("My guess is: " + guess);

            String feedback = getUserFeedback(sc);

            if (feedback.equals("correct")) {
                System.out.println("🎉 Yay! I guessed your number correctly.");
                break;
            } else if (feedback.equals("high") || feedback.equals("low")) {
                updateRange(feedback, guess);
            } else {
                System.out.println("Invalid input. Please enter high, low, or correct.");
            }
        }

    }
}
